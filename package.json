{
  "name": "readmore-js",
  "version": "3.0.0-beta-1",
  "description": "A lightweight JavaScript plugin for collapsing and expanding long blocks of text with \"Read more\" and \"Close\" links.",
  "main": "dist/readmore.js",
  "files": [
    "dist"
  ],
  "module": "dist/readmore.es6.js",
  "scripts": {
    "build": "rm -rf ./dist/* && npm-run-all -p build:*",
    "build:js": "rollup --config rollup.config.mjs",
    "build:html": "cpy \"src/*.html\" dist/",
    "watch": "npm-run-all -p watch:*",
    "watch:js": "npm run build:js -- --watch",
    "watch:html": "nodemon --watch src -e html -x \"npm run build:html\"",
    "serve": "http-server -p 9000 dist/",
    "start": "npm-run-all -p watch serve",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "./node_modules/eslint/bin/eslint.js --cache .",
    "precommit": "npm run lint #&& npm run test",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jedfoster/Readmore.js.git"
  },
  "keywords": [
    "css",
    "jquery",
    "readmore",
    "expand",
    "collapse"
  ],
  "author": "Jed Foster <jed@jedfoster.com>",
  "license": "MIT",
  "homepage": "https://github.com/jedfoster/Readmore.js",
  "bugs": {
    "url": "https://github.com/jedfoster/Readmore.js/issues"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@rollup/plugin-replace": "^6.0.3",
    "babel-eslint": "^10.0.1",
    "cpy-cli": "^7.0.0",
    "eslint": "^5.5.0",
    "eslint-config-airbnb-base": "^13.1.0",
    "eslint-plugin-import": "^2.14.0",
    "http-server": "^14.1.1",
    "husky": "^0.14.3",
    "nodemon": "^3.1.0",
    "npm-run-all2": "^9.0.0",
    "rollup": "^4.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24"
    }
  }
}
