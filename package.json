{
  "name": "readmore-js",
  "version": "3.0.0-beta-1",
  "description": "A lightweight JavaScript plugin for collapsing and expanding long blocks of text with \"Read more\" and \"Close\" links.",
  "main": "dist/readmore.js",
  "files": [
    "dist"
  ],
  "module": "dist/readmore.es6.js",
  "scripts": {
    "build": "rm -rf ./dist/* &&  npm-run-all -p build:*",
    "start": "npm-run-all -p watch serve",
    "test": "npm-run-all -pr test:server cypress:run",
    "test:watch": "npm-run-all -pr test:server cypress:open",
    "test:server": "http-server ./ -p 4444",
    "compress": "echo \"Error: no compress script\" && exit 1 # uglifyjs ./build/js/app.js -cmv --screw-ie8 -o ./build/js/app.js",
    "lint": "eslint --cache .",
    "precommit": "npm run lint #&& npm run test",
    "prepublish": "npm run build",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "serve": "http-server -p 9000 dist/",
    "build:html": "cpy \"src/*.html\" dist/",
    "build:js": "rollup --config rollup.config.js",
    "watch": "npm-run-all -p watch:*",
    "watch:js": "npm run build:js -- --watch",
    "watch:html": "nodemon --watch src -e html -x \"npm run build:html\""
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jedfoster/Readmore.js.git"
  },
  "keywords": [
    "css",
    "jquery",
    "readmore",
    "expand",
    "collapse"
  ],
  "author": "Jed Foster <jed@jedfoster.com>",
  "license": "MIT",
  "homepage": "https://github.com/jedfoster/Readmore.js",
  "bugs": {
    "url": "https://github.com/jedfoster/Readmore.js/issues"
  },
  "devDependencies": {
    "@babel/cli": "^7.14.8",
    "@babel/core": "^7.14.8",
    "@babel/eslint-parser": "^7.14.7",
    "@babel/plugin-transform-runtime": "^7.14.5",
    "@babel/preset-env": "^7.14.8",
    "@rollup/plugin-babel": "^5.3.0",
    "@rollup/plugin-node-resolve": "^13.0.4",
    "babel-eslint": "^10.1.0",
    "babel-plugin-module-resolver": "^4.1.0",
    "babel-plugin-transform-define": "^2.0.0",
    "copy-webpack-plugin": "^9.0.1",
    "core-js": "^3.15.2",
    "cpy-cli": "^3.1.1",
    "cypress": "^8.0.0",
    "eslint": "^7.31.0",
    "eslint-config-airbnb-base": "^14.2.1",
    "eslint-import-resolver-babel-module": "^5.3.1",
    "eslint-plugin-cypress": "^2.11.3",
    "eslint-plugin-import": "^2.23.4",
    "http-server": "^0.12.3",
    "husky": "^7.0.1",
    "nodemon": "^2.0.12",
    "npm-run-all": "^4.1.5",
    "regenerator-runtime": "^0.13.7"
  },
  "dependencies": {
    "@babel/runtime": "^7.14.8"
  }
}
